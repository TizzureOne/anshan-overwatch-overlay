<Application x:Class="AnshanOverlay.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#27374A"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#F4F6F9"/><Setter Property="Foreground" Value="#27374A"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#27374A"/></Style>
  <SolidColorBrush x:Key="PanelBrush" Color="#E5EAF0"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#67768A"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#27374A"/><Setter Property="Background" Value="#F4F6F9"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <EventSetter Event="MouseEnter" Handler="ButtonHover"/><EventSetter Event="MouseLeave" Handler="ButtonHover"/>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ButtonPress"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ButtonHover"/>
   <Setter Property="Background" Value="#E5EAF0"/><Setter Property="Foreground" Value="#27374A"/>
   <Setter Property="BorderBrush" Value="#C5CFDB"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Bd" Background="Transparent"><Canvas IsHitTestVisible="False"><Path Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" x:Name="Armor" Data="M 0,0 L 96,0 L 100,4 L 100,100 L 4,100 L 0,96 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/></Canvas><Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Armor" Property="Stroke" Value="#CC720A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#27374A"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,12,4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#E5EAF0"/><Setter Property="Foreground" Value="#27374A"/><Setter Property="CaretBrush" Value="#27374A"/><Setter Property="BorderBrush" Value="#C5CFDB"/><Setter Property="SelectionBrush" Value="#FF9C27"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Foreground" Value="#67768A"/><Setter Property="Background" Value="#E5EAF0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="0" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#CC720A"/><Setter TargetName="Tab" Property="Background" Value="#E5EAF0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
